# Copie para .env.producao (que fica FORA do git) na maquina da loja e preencha.

# --- Banco do CREARE/Compilart (MySQL/MariaDB, na propria loja) ---
SERVIDOR_CREARE_COMPILART="localhost"
PORTA_CREARE_COMPILART="3306"
BANCO_CREARE_COMPILART="gerente"
USUARIO_CREARE_COMPILART="root"
SENHA_CREARE_COMPILART=""

# --- API do ERP (na internet) e chave de integracao ---
PADARIA_API_URL="https://api-sistema.cicluzieai.com.br"
# Gere na tela Integracoes do ERP (login admin -> Integracoes -> criar chave "Vendas do PDV").
PADARIA_INTEGRACAO_CODIGO=""

# --- Sincronizacao (opcionais; defaults entre colchetes) ---
# Intervalo entre ciclos no modo loop (npm run agente).
SYNC_INTERVALO_MINUTOS="10"
# Na 1a execucao (sem cursor), quantos dias para tras comecar (backfill inicial).
SYNC_DIAS_INICIAIS="1"
# Idade maxima do lock antes de considera-lo obsoleto e poder rouba-lo.
SYNC_LOCK_MAX_MINUTOS="30"
# Retry de rede por venda.
SYNC_RETRY_TENTATIVAS="4"
SYNC_RETRY_BASE_MS="500"
# Pasta do estado de runtime (cursor + fila + lock). Relativa ao workspace por padrao.
SYNC_ESTADO_DIR=".estado"
# Vazio = rotula a hora local do CREARE como UTC (mesma convencao do caixa do ERP).
# Use "-03:00" apenas se um dia o ERP passar a gravar UTC real.
SYNC_FUSO_OFFSET=""
