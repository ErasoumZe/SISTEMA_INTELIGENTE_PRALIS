NODE_ENV=development
API_PORT=4100
WEB_PORT=5174
POSTGRES_USER=padaria
POSTGRES_PASSWORD=padaria
POSTGRES_DB=padaria
POSTGRES_PORT=5543
DATABASE_URL=postgresql://padaria:padaria@localhost:5543/padaria
BETTER_AUTH_SECRET=change-me-in-production-with-at-least-32-chars
AUTH_BASE_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:5174
PUBLIC_API_URL=http://localhost:4100
NUXT_PUBLIC_API_URL=http://localhost:4100

# Leitura assistida de notas fiscais. A chave fica somente no backend.
# Copie estas linhas para .env.local; nunca use prefixo NUXT_PUBLIC_ na chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=90000
# Apenas desenvolvimento: preenche a conferência com valores artificiais para testar o fluxo.
# Nunca representa uma leitura de documento; não habilite junto do uso operacional.
GEMINI_MAQUININHA_SIMULADA=false
COMPRAS_NOVO_FLUXO=false

# Transcrição de voz do fechamento de caixa (GroqCloud). A chave fica somente no backend.
# O áudio é enviado à Groq só ao confirmar a gravação e não é salvo pelo Pralis. Nunca use
# NUXT_PUBLIC_ e não cole a chave no navegador nem no repositório.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT_MS=90000

# Observabilidade opcional (rastreamento de erros). Sem DSN, e no-op.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# E-mail transacional (reset de senha + verificacao). Em DEV, deixe vazio: os e-mails so aparecem
# no log da API (com o link). Em PRODUCAO, crie uma conta em resend.com, verifique o dominio e
# preencha os dois. EMAIL_FROM precisa ser um remetente do dominio verificado.
RESEND_API_KEY=
EMAIL_FROM=Cicluz <nao-responda@emails.cicluzieai.com.br>

# Importacao de NF-e da contabilidade (webhook Make.com). Sem os dois, a rota de importacao
# responde 422 (NOTAS_FISCAIS_NAO_CONFIGURADO) e o resto do sistema segue normal. O CNPJ de cada
# empresa NAO vem daqui: e lido de empresas.cnpj (preencha na tela de Empresas).
NOTAS_FISCAIS_URL=
NOTAS_FISCAIS_TOKEN=
# Identificador FIXO da contabilidade no filtro (campo `company`). NAO e o CNPJ da empresa
# consultada. So mude se trocar de contabilidade. 14 digitos (a pontuacao e removida no boot).
NOTAS_FISCAIS_COMPANY=08351168000153

# Bootstrap de producao (db/bootstrap-prod.ts) — cria o primeiro admin + empresa no deploy.
# ADMIN_EMAIL/ADMIN_SENHA sao OBRIGATORIOS em producao (defina como segredos no painel do Coolify).
ADMIN_EMAIL=sistema@cicluz.com.br
ADMIN_SENHA=troque-esta-senha-forte
ADMIN_NOME=Administrador
EMPRESA_NOME=Padaria Principal
