NODE_ENV=development
API_PORT=4100
WEB_PORT=5174
POSTGRES_USER=padaria
POSTGRES_PASSWORD=padaria
POSTGRES_DB=padaria
POSTGRES_PORT=5543
DATABASE_URL=postgresql://padaria:padaria@localhost:5543/padaria
BETTER_AUTH_SECRET=change-me-in-production-with-at-least-32-chars
AUTH_BASE_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:5174
PUBLIC_API_URL=http://localhost:4100
NUXT_PUBLIC_API_URL=http://localhost:4100

# Observabilidade opcional (rastreamento de erros). Sem DSN, e no-op.
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# E-mail transacional (reset de senha + verificacao). Em DEV, deixe vazio: os e-mails so aparecem
# no log da API (com o link). Em PRODUCAO, crie uma conta em resend.com, verifique o dominio e
# preencha os dois. EMAIL_FROM precisa ser um remetente do dominio verificado.
RESEND_API_KEY=
EMAIL_FROM=Cicluz <nao-responda@emails.cicluzieai.com.br>

# Bootstrap de producao (db/bootstrap-prod.ts) — cria o primeiro admin + empresa no deploy.
# ADMIN_EMAIL/ADMIN_SENHA sao OBRIGATORIOS em producao (defina como segredos no painel do Coolify).
ADMIN_EMAIL=sistema@cicluz.com.br
ADMIN_SENHA=troque-esta-senha-forte
ADMIN_NOME=Administrador
EMPRESA_NOME=Padaria Principal
