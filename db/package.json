{
  "name": "@padaria/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./referencia-permissoes": {
      "types": "./dist/src/referencia-permissoes.d.ts",
      "development": "./src/referencia-permissoes.ts",
      "default": "./dist/src/referencia-permissoes.js"
    },
    "./schema": {
      "types": "./dist/src/schema/index.d.ts",
      "development": "./src/schema/index.ts",
      "default": "./dist/src/schema/index.js"
    },
    "./schema/autenticacao": {
      "types": "./dist/src/schema/autenticacao/autenticacao.schema.d.ts",
      "development": "./src/schema/autenticacao/autenticacao.schema.ts",
      "default": "./dist/src/schema/autenticacao/autenticacao.schema.js"
    },
    "./schema/cadastro": {
      "types": "./dist/src/schema/cadastro/cadastro.schema.d.ts",
      "development": "./src/schema/cadastro/cadastro.schema.ts",
      "default": "./dist/src/schema/cadastro/cadastro.schema.js"
    },
    "./schema/caixa": {
      "types": "./dist/src/schema/caixa/caixa.schema.d.ts",
      "development": "./src/schema/caixa/caixa.schema.ts",
      "default": "./dist/src/schema/caixa/caixa.schema.js"
    },
    "./schema/despesa": {
      "types": "./dist/src/schema/despesa/despesa.schema.d.ts",
      "development": "./src/schema/despesa/despesa.schema.ts",
      "default": "./dist/src/schema/despesa/despesa.schema.js"
    },
    "./schema/lancamento": {
      "types": "./dist/src/schema/lancamento/lancamento.schema.d.ts",
      "development": "./src/schema/lancamento/lancamento.schema.ts",
      "default": "./dist/src/schema/lancamento/lancamento.schema.js"
    },
    "./schema/mercadoria": {
      "types": "./dist/src/schema/mercadoria/mercadoria.schema.d.ts",
      "development": "./src/schema/mercadoria/mercadoria.schema.ts",
      "default": "./dist/src/schema/mercadoria/mercadoria.schema.js"
    },
    "./schema/nota-fiscal": {
      "types": "./dist/src/schema/nota-fiscal/nota-fiscal.schema.d.ts",
      "development": "./src/schema/nota-fiscal/nota-fiscal.schema.ts",
      "default": "./dist/src/schema/nota-fiscal/nota-fiscal.schema.js"
    },
    "./schema/retirada": {
      "types": "./dist/src/schema/retirada/retirada.schema.d.ts",
      "development": "./src/schema/retirada/retirada.schema.ts",
      "default": "./dist/src/schema/retirada/retirada.schema.js"
    },
    "./schema/transferencia": {
      "types": "./dist/src/schema/transferencia/transferencia.schema.d.ts",
      "development": "./src/schema/transferencia/transferencia.schema.ts",
      "default": "./dist/src/schema/transferencia/transferencia.schema.js"
    },
    "./schema/tema": {
      "types": "./dist/src/schema/tema/tema.schema.d.ts",
      "development": "./src/schema/tema/tema.schema.ts",
      "default": "./dist/src/schema/tema/tema.schema.js"
    },
    "./schema/venda": {
      "types": "./dist/src/schema/venda/venda.schema.d.ts",
      "development": "./src/schema/venda/venda.schema.ts",
      "default": "./dist/src/schema/venda/venda.schema.js"
    },
    "./schema/*": {
      "types": "./dist/src/schema/*.d.ts",
      "development": "./src/schema/*.ts",
      "default": "./dist/src/schema/*.js"
    },
    "./sessao": {
      "types": "./dist/src/sessao.d.ts",
      "development": "./src/sessao.ts",
      "default": "./dist/src/sessao.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "tsx baseline-migrations.ts",
    "bootstrap:prod": "tsx bootstrap-prod.ts",
    "bootstrap:contas-usuarios": "tsx bootstrap-contas-usuarios.ts",
    "diagnostico:fuso": "tsx diagnostico-fuso.ts",
    "planilha:inspecionar": "tsx planilha-inspecionar.ts",
    "seed:referencia:prod": "tsx seed-referencia-prod.ts",
    "seed:dev": "tsx --conditions=development seed.ts",
    "backfill:codigos": "tsx --conditions=development backfill-codigos.ts",
    "setup": "drizzle-kit push",
    "setup:dev": "node setup-dev.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.20",
    "@padaria/shared": "0.1.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
