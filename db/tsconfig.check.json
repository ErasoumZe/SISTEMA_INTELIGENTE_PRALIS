  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "@padaria/shared": ["shared/src/index.ts"],
      "@padaria/shared/*": ["shared/src/*/index.ts"]
    }
  },
  "include": [
