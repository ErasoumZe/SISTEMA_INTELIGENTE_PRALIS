FROM node:22-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json* tsconfig.base.json ./
COPY api/package.json api/package.json
COPY db/package.json db/package.json
COPY integracoes-scripts/package.json integracoes-scripts/package.json
COPY shared/package.json shared/package.json
COPY tests/package.json tests/package.json
COPY web-vue/package.json web-vue/package.json

RUN npm ci

FROM node:22-alpine AS build

WORKDIR /app

ARG NUXT_PUBLIC_API_URL
ARG PUBLIC_API_URL
ENV NUXT_PUBLIC_API_URL=${NUXT_PUBLIC_API_URL}
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# `shared` PRECISA ser compilado antes do generate, igual o api/Dockerfile.prod ja faz. O
# `.dockerignore` exclui `**/dist`, entao `shared/dist` nao existe na imagem — e o `vue-tsc` (o
# nuxt.config liga `typeCheck: true`) resolve os SUBCAMINHOS de @padaria/shared pelo `exports.types`
# do package.json, que aponta para `./dist/<sub>/index.d.ts`. Sem esse passo, todo
# `@padaria/shared/notificacoes|recorrencia|api` vira TS2307 e o generate sai com codigo 2.
#
# Na maquina de quem desenvolve isso nao aparece: `npm run lint` roda `build:libs` e deixa o
# `shared/dist` no disco, entao o `nuxt typecheck` local se apoia num resto de build anterior. So a
# imagem limpa conta a verdade. Derrubou o deploy de 04/08/2026.
RUN npm run build --workspace @padaria/shared
RUN npm run generate --workspace @padaria/web-vue

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY --chown=101:101 web-vue/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 --from=build /app/web-vue/.output/public /usr/share/nginx/html

EXPOSE 8080
